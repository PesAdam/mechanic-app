# HTTPS for the shop's domain is issued and renewed automatically (Let's Encrypt).
{$APP_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 25MB
	}
	reverse_proxy app:8080
}

# www.<domain> only redirects; it needs its own DNS record, otherwise Caddy just logs a failed certificate.
www.{$APP_DOMAIN} {
	redir https://{$APP_DOMAIN}{uri} permanent
}
