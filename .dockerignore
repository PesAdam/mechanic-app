# Keep local state, secrets and dev artifacts out of the image.
.git
.github
**/.DS_Store
**/node_modules
api/vendor
api/.env
api/.env.*
!api/.env.example
api/database/*.sqlite*
api/storage/app/*
api/storage/logs/*
api/storage/framework/cache/data/*
api/storage/framework/sessions/*
api/storage/framework/views/*
api/bootstrap/cache/*.php
api/public/assets
api/public/index.html
api/public/sw.js
api/public/workbox-*.js
api/public/manifest.webmanifest
api/public/storage
api/tests
web/dist
web/playwright-report
web/test-results
web/e2e
*.md
