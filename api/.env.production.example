# Produkčné nastavenie – skopíruj do koreňa repa ako .env (vedľa docker-compose.yml) a vyplň.
APP_NAME="Dielňa"
APP_ENV=production
APP_DEBUG=false
# Vygeneruj: openssl rand -base64 32  → hodnota je "base64:<výstup>"
APP_KEY=
# Verejná adresa appky (s https) a doména pre Caddy (bez https://)
APP_URL=https://dielna.example.sk
APP_DOMAIN=dielna.example.sk

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# MySQL v kontajneri "db" (DB_HOST/DB_PORT dopĺňa docker-compose.yml)
DB_DATABASE=dielna
DB_USERNAME=dielna
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log

# Pokusy o prihlásenie za minútu z jednej IP
AUTH_LOGIN_PER_MINUTE=10
